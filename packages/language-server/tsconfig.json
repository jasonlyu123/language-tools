{
    "compilerOptions": {
        "lib": ["es2021"],
        "target": "es2021",
        "moduleResolution": "node16",
        "module": "Node16",

        "outDir": "dist",
        "strict": true,
        "declaration": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "composite": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "mocha"]
    }
}
